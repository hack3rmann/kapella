VERSION 0.1.0

ID 'render-job'

// Script input variables. Must be specified on the image build time.
EXTERN home

// Clone Git repo
waywe := GIT {
    URL = 'https://github.com/hack3rmann/waywe-rs',
    REV = '76712398yoiuhqwfe87',
}

kapella := GIT {
    URL = 'https://github.com/hack3rmann/kapella',
    REV = '76712398yoiuhqwfe87',
}

// Execute shell
SHELL {
    PATH = "{home}/data",
    BASH = 'local-util --build .',
}

// Clone data from the master server
shared-data := LOCAL {
    PATH = "{home}/data",
    EXCLUDE = '^.*\.mp4$',
}

ENV 'WAYWE_EXAMPLES' "{waywe.path}/crates/examples"
